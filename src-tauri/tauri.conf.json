{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnergyBaseline",
  "version": "5.2.0",
  "identifier": "org.energybaseline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EnergyBaseline — M&V & Statistical Time-Series Baseline Platform",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../sidecar/dist/energybaseline_sidecar/": "energybaseline_sidecar/"
    },
    "fileAssociations": [
      {
        "ext": ["ebproj"],
        "name": "EnergyBaseline Project",
        "description": "EnergyBaseline M&V Project Container",
        "mimeType": "application/vnd.energybaseline.project+zip"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
